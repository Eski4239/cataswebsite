RESEND_API_KEY=
# Resend Audience that stores newsletter subscribers (Resend dashboard -> Audiences)
RESEND_AUDIENCE_ID=

# --- Telegram content agent (src/app/api/telegram) ---
TELEGRAM_BOT_TOKEN=
# Random string you invent; Telegram sends it back on every webhook call so we can reject forgeries
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram usernames or numeric IDs allowed to use the bot.
# Scheduled messages (weekly digest, backups) only reach the NUMERIC IDs, so add both: send /id to the bot to get yours.
TELEGRAM_ALLOWED_USERS=jajasaluu2,pabsgv
ANTHROPIC_API_KEY=
# Fine-grained GitHub token: this repo only, permission "Contents: read and write"
GITHUB_TOKEN=
# Secret for the daily cron job (src/app/api/cron/daily); Vercel sends it automatically. Any long random string.
CRON_SECRET=
# Vercel API token (vercel.com/account/tokens, scoped to the team) — enables site stats
VERCEL_API_TOKEN=

# Optional overrides
# AGENT_MODEL=claude-sonnet-5
# GITHUB_REPO=Eski4239/cataswebsite
# GITHUB_BRANCH=main
# TELEGRAM_NOTIFY_CHAT_IDS=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
